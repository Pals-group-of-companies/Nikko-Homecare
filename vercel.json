{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/about",
      "destination": "/about-us/",
      "permanent": true
    },
    {
      "source": "/about/",
      "destination": "/about-us/",
      "permanent": true
    },
    {
      "source": "/our-services/",
      "destination": "/services/",
      "permanent": true
    },
    {
      "source": "/elderly-care/",
      "destination": "/services/",
      "permanent": true
    },
    {
      "source": "/gallery/",
      "destination": "/our-residence/",
      "permanent": true
    },
    {
      "source": "/faq/",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/appointment/",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/support/",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/contact-us/",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/disclaimer/",
      "destination": "/terms-of-service/",
      "permanent": true
    },
    {
      "source": "/feed/",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/wp-login.php",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/wp-admin/:path*",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    }
  ]
}
